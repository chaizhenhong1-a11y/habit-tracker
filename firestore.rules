rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/state/main {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validState() {
        return request.resource.data.keys().hasOnly(['revision', 'payload', 'updatedAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 800000
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && validState() && request.resource.data.revision == 1;
      allow update: if owner() && validState()
        && request.resource.data.revision == resource.data.revision + 1;
    }
    match /users/{uid}/media/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['chunks'])
        && request.resource.data.chunks is int
        && request.resource.data.chunks > 0 && request.resource.data.chunks <= 100;
      match /chunks/{chunk} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 600000;
      }
    }
  }
}
